"use strict";
(() => {
  const documentData = JSON.parse(document.getElementById("architecture-data").textContent);
  const $ = (id) => document.getElementById(id);
  const NS = "http://www.w3.org/2000/svg";
  const labels = ["Shared platform", "EZ Visa connections", "Text AI workflow", "Real-time voice", "Runtime services"];
  const viewport = $("viewport"), workspace = $("workspace");
  let active = 0, selected = null, zoom = 1, svg, dimensions, drag = null;
  const svgStyle = `.node{cursor:pointer;outline:none}.node rect,.node polygon{fill:#fff;stroke:#c7dacf;stroke-width:1.3}.node .accent{fill:#147767}.node.ai rect{fill:#f6f3ff;stroke:#d1c7ea}.node.ai .accent{fill:#7160b4}.node.data rect{fill:#fff9ed;stroke:#e2d0a9}.node.data .accent{fill:#a46c25}.node text{font-family:Inter,Arial,sans-serif;fill:#294c40;font-size:12px;font-weight:500;pointer-events:none}.node.selected rect,.node:focus rect,.node:hover rect{stroke:#147767;stroke-width:2.5;fill:#eaf5ef}.node.selected text{font-weight:700}.edge{fill:none;stroke:#b0c2b5;stroke-width:1.3}.edge-label{font:9px Arial,sans-serif;fill:#718677;paint-order:stroke;stroke:#fafcf9;stroke-width:4px;stroke-linejoin:round}.node .ordinal{font-size:9px;font-weight:600;fill:#8b9d90}.edge.selected-edge{stroke:#267c60;stroke-width:2}`;
  function element(name, attrs = {}, text) {
    const el = document.createElementNS(NS, name);
    for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));
    if (text !== undefined) el.textContent = text;
    return el;
  }
  function category(node) {
    if (/Mongo|DB$|History$|MySQL|Redis|Transcript/.test(node.id)) return "data";
    if (/Gemini|model|agent|retriev|knowledge|guidance/i.test(node.label) && !/frontend|workflow|models|details/.test(node.label)) return "ai";
    return "platform";
  }
  function wrap(text, limit = 27) {
    const lines = []; let line = "";
    for (const word of text.split(/\s+/)) {
      if (line && (line + " " + word).length > limit) { lines.push(line); line = word; }
      else line += (line ? " " : "") + word;
    }
    if (line) lines.push(line);
    return lines;
  }
  function draw(diagram) {
    const width = Math.max(780, Math.max(...diagram.rows.map((r) => r.length)) * 250 + 80);
    const nodeWidth = 212, nodeHeight = 96, rowHeight = 150;
    const height = diagram.rows.length * rowHeight + 55;
    dimensions = { width, height };
    const positions = new Map();
    diagram.rows.forEach((row, level) => row.forEach((id, column) => {
      positions.set(id, { x: width / 2 + (column - (row.length - 1) / 2) * 250, y: 55 + level * rowHeight });
    }));
    svg = element("svg", { xmlns: NS, viewBox: `0 0 ${width} ${height}`, role: "group", "aria-label": diagram.title });
    svg.append(element("title", {}, diagram.title), element("desc", {}, "Top-down interactive architecture. Each component opens an explanation."));
    const defs = element("defs");
    defs.append(element("style", {}, svgStyle));
    for (const name of ["arrow", "arrow-start"]) {
      const marker = element("marker", { id: name, markerWidth: 8, markerHeight: 8, refX: name === "arrow" ? 7 : 1, refY: 4, orient: "auto", markerUnits: "strokeWidth" });
      marker.append(element("path", { d: name === "arrow" ? "M0 0L8 4L0 8Z" : "M8 0L0 4L8 8Z", fill: "#91ab98" }));
      defs.append(marker);
    }
    svg.append(defs);
    diagram.edges.forEach((edge, index) => {
      const a = positions.get(edge.source), b = positions.get(edge.target);
      let sx = a.x, sy = a.y + nodeHeight, tx = b.x, ty = b.y, path, lx, ly;
      if (b.y > a.y) {
        const mid = (sy + ty) / 2;
        path = `M${sx},${sy} C${sx},${mid} ${tx},${mid} ${tx},${ty - 4}`;
        lx = (sx + tx) / 2; ly = mid - 7;
      } else {
        const direction = a.x > width / 2 ? 1 : -1;
        sx += direction * nodeWidth / 2; sy = a.y + nodeHeight / 2;
        tx += direction * nodeWidth / 2; ty = b.y + nodeHeight / 2;
        const offset = direction * (42 + (index % 4) * 12);
        path = `M${sx},${sy} C${sx + offset},${sy} ${tx + offset},${ty} ${tx},${ty}`;
        lx = (sx + tx) / 2 + offset; ly = (sy + ty) / 2 - 7;
      }
      const line = element("path", { d: path, class: "edge", "marker-end": "url(#arrow)", "data-source": edge.source, "data-target": edge.target });
      if (edge.both) line.setAttribute("marker-start", "url(#arrow-start)");
      svg.append(line);
      if (edge.label) {
        const text = element("text", { x: lx, y: ly, "text-anchor": "middle", class: "edge-label" });
        wrap(edge.label, 33).forEach((part, i) => text.append(element("tspan", { x: lx, dy: i ? 12 : 0 }, part)));
        svg.append(text);
      }
    });
    diagram.nodes.forEach((node, index) => {
      const pos = positions.get(node.id);
      const group = element("g", { class: `node ${category(node)}`, transform: `translate(${pos.x - nodeWidth / 2},${pos.y})`, role: "button", tabindex: 0, "aria-label": `${node.label}. Show component details.`, "aria-pressed": "false", "data-node": node.id });
      group.append(element("title", {}, node.label), element("rect", { width: nodeWidth, height: nodeHeight, rx: 11 }));
      group.append(element("rect", { x: 13, y: 15, width: 5, height: 5, rx: 1.5, class: "accent" }));
      group.append(element("text", { x: nodeWidth - 13, y: 21, "text-anchor": "end", class: "ordinal" }, String(index + 1).padStart(2, "0")));
      const lines = wrap(node.label), text = element("text", { x: nodeWidth / 2, y: 36 + Math.max(0, (3 - lines.length) * 5), "text-anchor": "middle" });
      lines.forEach((line, i) => text.append(element("tspan", { x: nodeWidth / 2, dy: i ? 16 : 0 }, line)));
      group.append(text);
      group.addEventListener("click", () => inspect(node.id));
      group.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); inspect(node.id); }
      });
      svg.append(group);
    });
    $("diagram").replaceChildren(svg);
  }
  function inspect(id, navigate = false) {
    const diagram = documentData.diagrams[active];
    selected = id;
    const node = diagram.nodes.find((item) => item.id === id);
    for (const cell of svg.querySelectorAll(".node")) {
      const chosen = cell.dataset.node === id;
      cell.classList.toggle("selected", chosen); cell.setAttribute("aria-pressed", String(chosen));
      if (chosen && navigate) cell.scrollIntoView({ block: "nearest", inline: "nearest" });
    }
    for (const edge of svg.querySelectorAll(".edge")) edge.classList.toggle("selected-edge", edge.dataset.source === id || edge.dataset.target === id);
    $("component-title").textContent = node ? node.label : "Explore this view";
    $("component-description").textContent = node ? node.explanation : diagram.summary;
    $("component-type").textContent = node ? { ai: "AI component", data: "Data & persistence", platform: "Platform component" }[category(node)] : "Overview";
    $("component-index").textContent = node ? `${diagram.nodes.findIndex((n) => n.id === id) + 1} / ${diagram.nodes.length}` : `${diagram.nodes.length} components`;
    $("connections-section").hidden = !node;
    $("connections").replaceChildren();
    const connected = new Set();
    for (const edge of diagram.edges) {
      const target = edge.source === id ? edge.target : edge.target === id ? edge.source : null;
      if (!target || connected.has(target)) continue;
      connected.add(target);
      const button = document.createElement("button"); button.type = "button"; button.className = "connection";
      const arrow = document.createElement("span"); arrow.textContent = edge.both ? "↔" : edge.source === id ? "↗" : "↙";
      button.append(arrow, document.createTextNode(diagram.nodes.find((n) => n.id === target).label));
      button.addEventListener("click", () => inspect(target, true));
      $("connections").append(button);
    }
    $("announcement").textContent = node ? `Selected ${node.label}` : `Showing ${diagram.title}`;
  }
  function setZoom(next, center = true) {
    const previous = zoom, cx = (viewport.scrollLeft + viewport.clientWidth / 2 - 30) / previous, cy = (viewport.scrollTop + viewport.clientHeight / 2 - 26) / previous;
    zoom = Math.max(.25, Math.min(2, next));
    svg.setAttribute("width", dimensions.width * zoom); svg.setAttribute("height", dimensions.height * zoom);
    $("zoom-label").textContent = `${Math.round(zoom * 100)}%`;
    $("zoom-out").disabled = zoom <= .25; $("zoom-in").disabled = zoom >= 2;
    if (center) { viewport.scrollLeft = cx * zoom - viewport.clientWidth / 2 + 30; viewport.scrollTop = cy * zoom - viewport.clientHeight / 2 + 26; }
  }
  function fit() { setZoom(Math.min(1, (viewport.clientWidth - 70) / dimensions.width), false); viewport.scrollTop = 0; viewport.scrollLeft = 0; }
  function show(index, updateHash = true) {
    active = index;
    const diagram = documentData.diagrams[active];
    $("diagram-title").textContent = diagram.title;
    $("diagram-number").textContent = `VIEW ${String(index + 1).padStart(2, "0")} / 05`;
    for (const [i, button] of [...document.querySelectorAll(".tab")].entries()) button.setAttribute("aria-pressed", String(i === index));
    $("mermaid-source").textContent = diagram.source;
    $("references").replaceChildren(...diagram.references.map((reference) => { const item = document.createElement("li"); item.textContent = reference; return item; }));
    draw(diagram); inspect(null); fit();
    if (updateHash) history.replaceState(null, "", `#view-${index + 1}`);
  }
  documentData.diagrams.forEach((diagram, index) => {
    const button = document.createElement("button"); button.type = "button"; button.className = "tab";
    const number = document.createElement("span"); number.className = "tab-number"; number.textContent = String(index + 1).padStart(2, "0");
    button.append(number, document.createTextNode(labels[index])); button.addEventListener("click", () => show(index));
    document.querySelector(".diagram-tabs").append(button);
  });
  $("zoom-in").addEventListener("click", () => setZoom(zoom + .15));
  $("zoom-out").addEventListener("click", () => setZoom(zoom - .15));
  $("fit").addEventListener("click", fit);
  $("print").addEventListener("click", () => window.print());
  $("export").addEventListener("click", () => {
    const clone = svg.cloneNode(true); clone.setAttribute("width", dimensions.width); clone.setAttribute("height", dimensions.height);
    const blob = new Blob([new XMLSerializer().serializeToString(clone)], { type: "image/svg+xml;charset=utf-8" });
    const url = URL.createObjectURL(blob), link = document.createElement("a");
    link.href = url; link.download = `travel-mind-architecture-${active + 1}.svg`; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  function syncFullscreen() {
    const expanded = document.fullscreenElement === workspace || workspace.classList.contains("expanded");
    $("fullscreen").setAttribute("aria-pressed", String(expanded));
    $("fullscreen").querySelector("span").textContent = expanded ? "Exit fullscreen" : "Fullscreen";
    requestAnimationFrame(fit);
  }
  $("fullscreen").addEventListener("click", async () => {
    if (document.fullscreenElement) await document.exitFullscreen();
    else if (workspace.classList.contains("expanded")) { workspace.classList.remove("expanded"); document.body.classList.remove("has-expanded"); }
    else {
      try { if (!workspace.requestFullscreen) throw new Error("Unsupported"); await workspace.requestFullscreen(); }
      catch { workspace.classList.add("expanded"); document.body.classList.add("has-expanded"); }
    }
    syncFullscreen();
  });
  document.addEventListener("fullscreenchange", syncFullscreen);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && workspace.classList.contains("expanded")) { workspace.classList.remove("expanded"); document.body.classList.remove("has-expanded"); syncFullscreen(); }
  });
  viewport.addEventListener("pointerdown", (event) => {
    if (event.pointerType === "touch" || event.button !== 0 || event.target.closest(".node")) return;
    drag = { x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop };
    viewport.setPointerCapture(event.pointerId); viewport.classList.add("dragging");
  });
  viewport.addEventListener("pointermove", (event) => { if (drag) { viewport.scrollLeft = drag.left - event.clientX + drag.x; viewport.scrollTop = drag.top - event.clientY + drag.y; } });
  for (const type of ["pointerup", "pointercancel", "lostpointercapture"]) viewport.addEventListener(type, () => { drag = null; viewport.classList.remove("dragging"); });
  function hashIndex() { const match = /^#view-([1-5])$/.exec(location.hash); return match ? Number(match[1]) - 1 : 0; }
  window.addEventListener("hashchange", () => show(hashIndex(), false));
  let resizeTimer;
  window.addEventListener("resize", () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(fit, 100); });
  show(hashIndex(), false);
})();
